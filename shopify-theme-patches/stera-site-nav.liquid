        <strong style="letter-spacing:.12em;text-transform:uppercase;font-size:12px;color:#2F5840;">Menu</strong>
        <button type="button" id="sp-close2" style="border:0;background:rgba(47,88,64,.08);width:40px;height:40px;border-radius:10px;font-size:20px;cursor:pointer;">×</button>
