<script>
(function(){
  function kill(){
    document.querySelectorAll('#header-component header-menu,#header-component .header-menu,#header-component overflow-list,#header-component .menu-list,#header-component .header__navigation-bar-row,header-menu').forEach(function(el){
      el.style.setProperty('display','none','important');
      el.setAttribute('hidden','hidden');
    });
  }
  function portal(){
    if(document.querySelector('.sp-portal-btn')) return;
    var carts=document.querySelectorAll('a[href*="/cart"]');
    var cart=carts[carts.length-1]; if(!cart) return;
    var a=document.createElement('a');
    a.href='/pages/klant-account'; a.className='sp-portal-btn'; a.textContent='Mijn Stera Pro';
    a.style.cssText='display:inline-flex;align-items:center;margin-left:10px;padding:7px 15px;border:1.5px solid #2F5840;border-radius:999px;color:#2F5840;font-weight:600;font-size:.85rem;text-decoration:none;white-space:nowrap';
    cart.insertAdjacentElement('afterend',a);
  }
  var drawer=document.getElementById('sp-drawer');
  var burger=document.getElementById('sp-burger');
  function open(){ if(drawer) drawer.classList.add('open'); }
  function close(){ if(drawer) drawer.classList.remove('open'); }
  if(burger) burger.addEventListener('click', open);
  var c1=document.getElementById('sp-close1');
  var c2=document.getElementById('sp-close2');
  if(c1) c1.addEventListener('click', close);
  if(c2) c2.addEventListener('click', close);
  if(drawer) drawer.querySelectorAll('a').forEach(function(a){ a.addEventListener('click', close); });
  kill(); portal();
  setTimeout(function(){ kill(); portal(); }, 200);
  setTimeout(function(){ kill(); portal(); }, 1000);
  setTimeout(kill, 2500);
})();
</script>
